{
	admin off
}

{$MINIAPP_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self'; font-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'; manifest-src 'self'"
	}

	@internal path /internal /internal/*
	handle @internal {
		respond 404
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy web:{$MINIAPP_PORT:8080} {
			health_uri /internal/readyz
			health_interval 30s
			health_timeout 5s
		}
	}

	handle {
		root * /srv

		@immutableAssets path /assets/*
		header @immutableAssets Cache-Control "public, max-age=31536000, immutable"

		@applicationShell {
			not path /assets/*
		}
		header @applicationShell Cache-Control "no-cache, no-store, must-revalidate"

		try_files {path} /index.html
		file_server
	}
}

http://127.0.0.1:2019 {
	respond "ok" 200
}
