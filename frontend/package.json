    "react-dom": ">=19.0.0 <20.0.0",
    "react-router-dom": ">=7.0.0 <8.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": ">=9.0.0 <10.0.0",
